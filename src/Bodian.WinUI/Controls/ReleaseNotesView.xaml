<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bodian.WinUI.Controls.ReleaseNotesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        发布说明的展示区。切分在 Core（Models/ReleaseNotes.cs，纯函数、可离线单测），
        这里只负责把切好的行铺出来。

        ★ **行内容在代码里拼，不走 DataTemplate。** 一行要渲染成若干个 Run
          （粗体与普通文本混排），而 `Run` 是 `Inline` 不是 `UIElement` ——
          塞进 ItemsControl 的模板容器（ContentPresenter）会直接抛。
          用 RichTextBlock 的段落模板也绕不开同一个问题，还得多一层解析。

        右侧留出 12 的内边距：滚动条压在正文上会盖住最后几个字。
    -->
    <ScrollViewer
        MaxHeight="200"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto"
        Visibility="Collapsed">
        <StackPanel
            x:Name="Host"
            Padding="0,0,12,0"
            Spacing="8" />
    </ScrollViewer>
</UserControl>

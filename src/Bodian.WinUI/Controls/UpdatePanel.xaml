<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bodian.WinUI.Controls.UpdatePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls"
    xmlns:local="using:Bodian.WinUI">

    <!--
        更新对话框的内容体（宿主见 Controls/UpdateDialog.cs）。

        ★ **标题不在这里。** 走到「发现新版本 0.2.0」这一行的是 ContentDialog 自己的
          dialog.Title —— 项目里每个对话框都是这么写的（添加到歌单 / 编辑歌单 / 清空播放列表…），
          自己再画一行 20px 的粗体只是把它重复一遍，字号还会跟框架那套对不上。

        内容体的尺寸跟其它对话框对齐：MinWidth 320、Spacing 12、正文用 FontSizeBody。
    -->
    <StackPanel MinWidth="320" Spacing="12">

        <!-- 当前版本 / 安装包大小 / 下载进度 / 失败原因，都用这一行。 -->
        <TextBlock
            FontSize="{StaticResource FontSizeBody}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.DetailText, Mode=OneWay}"
            TextWrapping="Wrap" />

        <!--
            进度槽。**检查中与下载中共用这一条**，只是前者是不确定态 ——
            分两处画会让对话框在「查完 → 开始下载」这一步跳一下高度。
        -->
        <ProgressBar
            IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
            Maximum="100"
            Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
            Visibility="{x:Bind local:Formats.Visible(ViewModel.IsProgressVisible), Mode=OneWay}" />

        <!-- 发布说明。切分在 Core，铺行在这个控件里。没有内容时整块收起来。 -->
        <controls:ReleaseNotesView x:Name="Notes" />

        <!-- 已取消、校验失败这类需要说一句的状态。平时空着，不占高度。 -->
        <TextBlock
            FontSize="{StaticResource FontSizeBody}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind local:Formats.Visible(ViewModel.HasStatus), Mode=OneWay}" />
    </StackPanel>
</UserControl>
